<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keyboard_color_bg">

    <!-- 输入框内容与描述均在运行时设置：描述走 hint，仅在内容为空时显示 -->
    <KeyboardEditText style="@style/keyboard_input_box"
        android:id="@+id/input_box"
        android:cursorWidth="3dp"
        android:cursorColor="@color/keyboard_color_cursor"
        android:cursorBlinkPeriod="500"
        android:cursorBlinkIdle="1000"/>
    <ImageView style="@style/keyboard_clear"
        android:id="@+id/clear"/>

    <Button style="@style/keyboard_cancel"
        android:id="@+id/cancel"
        android:text="取消"
        android:layout_toEndOf="@id/input_box"/>
    <Button style="@style/keyboard_enter"
        android:id="@+id/enter"
        android:text="确认"
        android:layout_toEndOf="@id/cancel"/>

    <RelativeLayout
        android:id="@+id/key_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>